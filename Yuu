<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HEIN SHOP v4.12 - Free Fire ID Random</title>
    <style>
        * { box-sizing: border-box; }
        body { background: #080808; color: #fff; text-align: center; font-family: sans-serif; padding: 20px; margin: 0; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .container { border: 2px solid #00ff66; padding: 25px; border-radius: 20px; width: 100%; max-width: 400px; box-shadow: 0 0 25px rgba(0,255,102,.4); background: rgba(17,17,17,.95); position: relative; }
        .badge { position: absolute; top: 15px; right: 15px; background: #00ff66; color: #000; font-weight: bold; font-size: 10px; padding: 3px 8px; border-radius: 10px; }
        h1 { color: #fff; text-shadow: 0 0 10px #00ff66; margin: 10px 0 5px 0; font-size: 28px; }
        p { color: #888; font-size: 13px; margin-bottom: 20px; }
        input { width: 100%; padding: 14px; margin-bottom: 12px; border: 1px solid #00ff66; background: #000; color: #00ff66; border-radius: 10px; text-align: center; font-size: 15px; outline: none; }
        button { width: 100%; padding: 15px; background: linear-gradient(45deg, #00ff66, #00cc52); color: #000; border: none; border-radius: 10px; font-weight: bold; font-size: 18px; cursor: pointer; margin-bottom: 10px; }
        #result-box { margin-top: 15px; padding: 15px; background: #181818; border: 1px dashed #00ff66; border-radius: 10px; display: none; }
        .code-display { font-family: monospace; color: #00ff66; font-size: 16px; margin: 10px 0; word-break: break-all; }
        .btn-copy { background: #333; color: #fff; padding: 8px 15px; font-size: 12px; border-radius: 5px; border: none; cursor: pointer; }
        .admin-link { display: block; margin-top: 15px; color: #555; font-size: 11px; cursor: pointer; }
        #admin-panel { display: none; margin-top: 15px; padding: 15px; border-top: 1px solid #333; background: #111; border-radius: 10px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="badge">v4.12 ADMIN</div>
        <h1>HEIN SHOP</h1>
        <p>⚡ ระบบสุ่มไอดีอัตโนมัติ ⚡</p>
        <input type="text" id="username" placeholder="กรอกชื่อของคุณ">
        <button id="spin-btn" onclick="startRandom()">[ เริ่มสุ่มไอดี ]</button>
        <div id="result-box">
            <span style="color:#aaa; font-size:12px;">ผลการสุ่มของคุณ:</span>
            <div id="user-display" style="font-weight:bold; color:#fff;"></div>
            <div id="code-result" class="code-display">กำลังสุ่ม...</div>
            <button class="btn-copy" onclick="copyResult()">📋 ก๊อปปี้รหัส</button>
        </div>
        <span class="admin-link" onclick="openAdmin()">[ เข้าสู่ระบบแอดมิน ]</span>
        <div id="admin-panel">
            <h3 style="color:#00ff66; margin-top:0;">⚡ แผงควบคุมแอดมิน ⚡</h3>
            <div id="admin-login-box">
                <input type="text" id="adm-user" placeholder="ชื่อผู้ใช้แอดมิน">
                <input type="password" id="adm-pass" placeholder="รหัสผ่าน">
                <button style="font-size:14px; padding:10px;" onclick="loginAdmin()">เข้าสู่ระบบ</button>
            </div>
            <div id="admin-tools" style="display:none;">
                <p style="color:#00ff66; font-size:12px;">ยินดีต้อนรับแอดมิน HEIN!</p>
                <input type="text" id="new-id" placeholder="ID:PASS ใหม่">
                <button style="font-size:14px; padding:10px;" onclick="addID()">+ เพิ่มไอดีเข้าระบบ</button>
            </div>
        </div>
    </div>
    <script>
        let accountList = ["ID: HEIN-VIP-999 | PASS: FF-GOD-2026", "ID: HEIN-EVO-888 | PASS: M1887-MAX", "ID: HEIN-STREET-777 | PASS: SET-RARE-99"];
        function startRandom() {
            const nameInput = document.getElementById('username').value.trim();
            if(!nameInput) { alert("❌ กรุณาใส่ชื่อก่อนสุ่มครับ!"); return; }
            const btn = document.getElementById('spin-btn');
            btn.disabled = true; btn.innerText = "🔄 กำลังสุ่ม...";
            document.getElementById('result-box').style.display = "block";
            document.getElementById('user-display').innerText = "คุณ " + nameInput;
            let counter = 0;
            const spinInterval = setInterval(() => {
                document.getElementById('code-result').innerText = accountList[Math.floor(Math.random() * accountList.length)].split('|')[0] + "...";
                counter++;
                if (counter > 10) {
                    clearInterval(spinInterval);
                    document.getElementById('code-result').innerText = accountList[Math.floor(Math.random() * accountList.length)];
                    btn.disabled = false; btn.innerText = "[ เริ่มสุ่มไอดี ]";
                }
            }, 80);
        }
        function copyResult() { navigator.clipboard.writeText(document.getElementById('code-result').innerText); alert("✅ คัดลอกรหัสเรียบร้อยแล้ว!"); }
        function openAdmin() { const p = document.getElementById('admin-panel'); p.style.display = p.style.display === 'block' ? 'none' : 'block'; }
        function loginAdmin() {
            if(document.getElementById('adm-user').value === "HEIN" && document.getElementById('adm-pass').value === "THH0963258") {
                alert("✅ เข้าสู่ระบบแอดมินสำเร็จ!");
                document.getElementById('admin-login-box').style.display = 'none';
                document.getElementById('admin-tools').style.display = 'block';
            } else { alert("❌ รหัสไม่ถูกต้อง!"); }
        }
        function addID() {
            const newID = document.getElementById('new-id').value.trim();
            if(!newID) return;
            accountList.push(newID); alert("✅ เพิ่มไอดีแล้ว!");
            document.getElementById('new-id').value = "";
        }
    </script>
</body>
</html>
